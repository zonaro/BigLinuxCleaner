[Desktop Entry]
Version=1.0
Type=Application
Name=BigLinux Cleaner
Name[pt_BR]=BigLinux Cleaner
GenericName=System Cleaner
GenericName[pt_BR]=Limpador do Sistema
Comment=Remove broken shortcuts, orphan packages and system cache
Comment[pt_BR]=Remove atalhos quebrados, pacotes órfãos e cache do sistema
Exec=bash -c 'cd "$(dirname "%k")" && exec bash launch.sh'
Icon=system-cleaner
Terminal=false
Categories=System;Settings;PackageManager;
Keywords=clean;cleaner;orphan;desktop;shortcut;cache;flatpak;snap;pacman;
Keywords[pt_BR]=limpar;limpeza;órfão;atalho;cache;flatpak;snap;pacman;
StartupNotify=true
StartupWMClass=biglinux-cleaner
