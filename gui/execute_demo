#!/bin/bash
#
# execute_demo — BigBashView launcher para BigLinuxCleaner GUI
#
# Abre "execute$./index.sh.html" a partir da RAIZ do docroot (-d GUI_DIR).
# Isso é obrigatório: os links relativos "execute$..." das páginas só
# funcionam quando a página atual é servida pela raiz do docroot. Se a
# página inicial for aberta de fora (ex.: arquivo temporário em /tmp),
# os botões resolvem para caminhos errados e o BBV devolve uma resposta
# vazia — que aparece como tela preta (cor de fundo -c black).
#

GUI_DIR="$(cd "$(dirname "$0")" && pwd)"

BBV=""
if command -v bigbashview >/dev/null 2>&1; then
    BBV="bigbashview"
elif [[ -x /usr/bin/bigbashview ]]; then
    BBV="/usr/bin/bigbashview"
elif [[ -x "$HOME/.local/bin/bigbashview" ]]; then
    BBV="$HOME/.local/bin/bigbashview"
fi

if [[ -z "$BBV" ]]; then
    echo "ERRO: BigBashView não encontrado."
    echo "Instale: sudo pacman -S bigbashview"
    exit 1
fi

ICON=""
if [[ -f "$GUI_DIR/../icon-256.png" ]]; then
    ICON="$GUI_DIR/../icon-256.png"
fi

# Garante permissão de execução: o BBV executa estes arquivos como scripts.
# Sem o bit +x, a execução falha com "Permission denied" e a janela fica preta.
chmod +x "$GUI_DIR/index.sh.html" "$GUI_DIR/tail_log.sh.html" \
    "$GUI_DIR/run_cleanup.sh" 2>/dev/null || true

BBV_ARGS=(-d "$GUI_DIR" -s 900x650 -n "BigLinuxCleaner" -c black)

[[ -n "$ICON" ]] && BBV_ARGS+=(-i "$ICON")

exec "$BBV" "${BBV_ARGS[@]}" "execute\$./index.sh.html"