#!/bin/bash
#
# execute_demo — BigBashView launcher para BigLinuxCleaner GUI
# Gera HTML em arquivo temporário e abre no BigBashView
#

GUI_DIR="$(cd "$(dirname "$0")" && pwd)"

BBV=""
if command -v bigbashview >/dev/null 2>&1; then
    BBV="bigbashview"
elif [[ -x /usr/bin/bigbashview ]]; then
    BBV="/usr/bin/bigbashview"
elif [[ -x "$HOME/.local/bin/bigbashview" ]]; then
    BBV="$HOME/.local/bin/bigbashview"
fi

if [[ -z "$BBV" ]]; then
    echo "ERRO: BigBashView não encontrado."
    echo "Instale: sudo pacman -S bigbashview"
    exit 1
fi

ICON=""
if [[ -f "$GUI_DIR/../icon-256.png" ]]; then
    ICON="$GUI_DIR/../icon-256.png"
fi

# Gera HTML em arquivo temporário
TMP_HTML="$(mktemp --suffix=.html)"
bash "$GUI_DIR/index.sh.html" > "$TMP_HTML"

BBV_ARGS=(-d "$GUI_DIR" -s 900x650 -n "BigLinuxCleaner" -c black)

[[ -n "$ICON" ]] && BBV_ARGS+=(-i "$ICON")

exec "$BBV" "${BBV_ARGS[@]}" "$TMP_HTML"